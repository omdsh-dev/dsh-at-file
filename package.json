{
  "name": "dsh-at-file",
  "description": "Codex-style @path references for the DeepSeek Harness web GUI: search workspace paths without injecting file content",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-typert-registry": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../dsh/packages/core/agent",
    "@deepseek-ai/dsh-typert-protocol": "link:../dsh/packages/typert/protocol",
    "@deepseek-ai/dsh-invariants": "link:../dsh/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/schemastery": "link:../dsh/vendor/schemastery",
    "@deepseek-ai/dsh-client-runtime": "link:../dsh/packages/client/runtime",
    "@deepseek-ai/dsh-api-remotes": "link:../dsh/packages/api/remotes",
    "@deepseek-ai/dsh-client-ui-input-trigger": "link:../dsh/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-slots": "link:../dsh/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../dsh/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-locale": "link:../dsh/packages/client/locale",
    "@deepseek-ai/dsh-client-connection": "link:../dsh/packages/client/connection",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.25.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-typert-registry": "link:../dsh/packages/typert/registry",
    "@deepseek-ai/dsh-settings": "link:../dsh/packages/settings/settings",
    "@deepseek-ai/dsh-client-ui-settings": "link:../dsh/packages/client/ui-settings",
    "@deepseek-ai/dsh-llm": "link:../dsh/packages/llm/llm"
  }
}
